import mysql.connector
import sys
import os

sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))   
from conexao import conecta
def livro_estoque():
    conn = conecta()
    cursor = conn.cursor()
    cursor.execute("SELECT l.titulo, l.isbn, l.ano_publicacao, l.quantidade, l.idioma, l.numero_paginas, e.data_emprestimo, e.data_devolucao_prevista,e.data_devolucao_real FROM livros l  left JOIN estoque e ON e.id_livro = l.id_livro")
    categorias = cursor.fetchall()
    cursor.close()
    conn.close()

    for i in categorias:
        print(i)

livro_estoque()





